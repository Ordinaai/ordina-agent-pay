# Leave any of these empty and that part runs as an offline mock.

# Claude (both agents). Without it, a scripted stand-in drives the same tools.
ANTHROPIC_API_KEY=
# AGENT_MODEL=claude-opus-5-5

# PayPal REST app from developer.paypal.com (Sandbox). Without them, PayPal is mocked.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# Spend protection for a public demo.
TURNS_PER_IP_PER_HOUR=30
DAILY_TURN_CAP=400

# Leave any of these empty and that part runs as an offline mock.

# Claude (both agents). Without it, a scripted stand-in drives the same tools.
ANTHROPIC_API_KEY=
# AGENT_MODEL=claude-opus-5-5

# PayPal REST app (Sandbox) of the Multiparty partner. Without it, PayPal is mocked.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# Spend protection for a public demo.
TURNS_PER_IP_PER_HOUR=30
DAILY_TURN_CAP=400

# SQLite data folder (DATA_DIR); on Render this is the disk at /var/data
# DATA_DIR=./data
# PayPal Multiparty partner details (from PayPal once Ordina is approved as a partner)
PAYPAL_PARTNER_MERCHANT_ID=
PAYPAL_BN_CODE=
# The demo businesses' seller: a Sandbox business account already connected to the partner app
DEMO_SELLER_MERCHANT_ID=
DEMO_SELLER_EMAIL=
# Hours after a booking ends before PayPal releases the money to the business
RELEASE_DELAY_HOURS=24
# Ordina's fee on each sale, taken by PayPal as a platform fee (0 at launch)
PLATFORM_FEE_PERCENT=0

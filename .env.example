# Leave any of these empty and that part runs as an offline mock.

# Claude (the playground's agent and every business's Secretary).
# Without it, a scripted stand-in drives the same tools.
ANTHROPIC_API_KEY=
# AGENT_MODEL=claude-opus-5-5

# PayPal REST app (Sandbox, type Merchant). Without the ID and secret, PayPal is mocked.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# The Sandbox BUSINESS account's Merchant ID (Sandbox accounts > the business account > Account ID).
# Required with real PayPal: every capture is checked against it, and payments are refused without it.
PAYPAL_SELLER_MERCHANT_ID=

# The public address, so pay links handed out over MCP point at it (e.g. https://agent-checkout.onrender.com).
# PUBLIC_URL=

# AI spend protection for a public demo (playground chat and MCP alike).
TURNS_PER_IP_PER_HOUR=30
DAILY_TURN_CAP=400

# SQLite data folder; on Render this is the disk at /var/data
# DATA_DIR=./data

# 1 opens business sign-up, sign-in and editing. Off: the business view shows the simulated businesses.
# BUSINESS_SIGNUP=

# Ordina's fee on each sale (0 at launch)
PLATFORM_FEE_PERCENT=0

# ---------- Multiparty (roadmap; needs PayPal partner approval) ----------
# PAYPAL_FLOW=multiparty
# PAYPAL_PARTNER_MERCHANT_ID=
# PAYPAL_BN_CODE=
# The demo businesses' seller: a Sandbox business account already connected to the partner app
# DEMO_SELLER_MERCHANT_ID=
# DEMO_SELLER_EMAIL=
# Hours after a booking ends before PayPal releases the money to the business
# RELEASE_DELAY_HOURS=24
